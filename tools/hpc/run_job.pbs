#!/bin/bash
# Generic AeroTrack job (submitted by tools/hpc/submit.sh; never edit per run -- the run is defined by the -v variables).
#   AT_RUN_ID   unique run / job id (state dir ~/aerotrack_server/jobs/$AT_RUN_ID)
#   (command)   read from $STATE/cmd.txt, written by submit.sh; run from the repository checkout
#   AT_GPU      1 = needs the node's GPU (guard + staging), 0 = CPU-only
#   AT_STAGE    1 = stage the data tree to /local and read it from there
#PBS -j oe
#PBS -r n
set -u
STATE="$HOME/aerotrack_server/jobs/$AT_RUN_ID"
mkdir -p "$STATE"
LOG="$STATE/job.log"
exec >> "$LOG" 2>&1
ev() { echo "{\"t\": \"$(date -Iseconds)\", \"job\": \"$AT_RUN_ID\", $1}" >> "$STATE/events.jsonl"; }
echo "=== $(date -Iseconds) job ${PBS_JOBID:-?} on $(hostname) ==="
rm -f "$STATE/DONE" "$STATE/FAILED" "$STATE/GPU_BUSY"
echo "${PBS_JOBID:-?} $(hostname) $(date -Iseconds)" > "$STATE/RUNNING"
ev "\"kind\": \"start\", \"pbs_job\": \"${PBS_JOBID:-}\", \"host\": \"$(hostname)\""
if [ "${AT_STAGE:-0}" = "1" ]; then source "$HOME/aerotrack_server/source/tools/hpc/job_env.sh" staged
else source "$HOME/aerotrack_server/source/tools/hpc/job_env.sh"; fi
if [ "${AT_GPU:-1}" = "1" ]; then
  if ! bash tools/hpc/gpu_guard.sh; then
    ev "\"kind\": \"gpu_busy\""; rm -f "$STATE/RUNNING"; touch "$STATE/GPU_BUSY"; exit 75
  fi
fi
if [ "${AT_STAGE:-0}" = "1" ]; then
  bash tools/hpc/stage_local.sh || { ev "\"kind\": \"failed\", \"stage\": \"staging\""; rm -f "$STATE/RUNNING"; touch "$STATE/FAILED"; exit 4; }
fi
python - > "$STATE/env.json" <<'PY'
import json, os, platform, subprocess, sys
import torch
d = {"host": platform.node(), "python": platform.python_version(), "torch": torch.__version__, "cuda_build": torch.version.cuda,
     "cudnn": torch.backends.cudnn.version(), "gpu": torch.cuda.get_device_name(0) if torch.cuda.is_available() else None,
     "git_commit": subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip(),
     "git_dirty": bool(subprocess.run(["git", "status", "--porcelain", "--untracked-files=no"], capture_output=True, text=True).stdout.strip()),
     "env": {k: os.environ.get(k) for k in ("AEROTRACK_CORPUS", "AEROTRACK_AMP", "AEROTRACK_PATH_MAP", "AT_DATA_ROOT", "OMP_NUM_THREADS")},
     "pbs_job": os.environ.get("PBS_JOBID"), "ncpus": os.environ.get("NCPUS")}
print(json.dumps(d, indent=1))
PY
export AT_CMD="$(cat "$STATE/cmd.txt")"
ev "\"kind\": \"run\", \"cmd\": $(python -c 'import json,os; print(json.dumps(os.environ["AT_CMD"]))')"
t0=$(date +%s)
bash -c "$AT_CMD"
rc=$?
rm -f "$STATE/RUNNING"
ev "\"kind\": \"end\", \"rc\": $rc, \"minutes\": $(( ($(date +%s) - t0) / 60 ))"
if [ $rc -eq 0 ]; then touch "$STATE/DONE"; else echo "$rc" > "$STATE/FAILED"; fi
exit $rc
