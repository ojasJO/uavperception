{
 "name": "cpu_c1_train",
 "purpose": "Track C / C1 (CPU only): learned forecasters on TRAIN with dev-split epoch choice -- mlp/gru/tfm x 3 seeds (abs), then noabs + aug arms of the dev-chosen family; no VAL access",
 "state_dir": "results/runs/_chains/cpu_c1_train",
 "wait_for": null,
 "jobs": [
  {
   "name": "c1_train_main",
   "cmd": [
    "{python}",
    "-u",
    "experiments/aerotrack_temporal/scripts/tc_c1.py",
    "--stage",
    "train",
    "--archs",
    "mlp,gru,tfm",
    "--variants",
    "abs"
   ],
   "required": true
  },
  {
   "name": "c1_train_ablations",
   "cmd": [
    "{python}",
    "-u",
    "experiments/aerotrack_temporal/scripts/tc_c1.py",
    "--stage",
    "train",
    "--archs",
    "auto",
    "--variants",
    "noabs,aug"
   ],
   "required": true
  }
 ]
}
